# Autosprint configuration — copy to .env and edit as needed.
#
# .env is OPTIONAL: autosprint runs on defaults if it is absent. Copy this file
# to .env only to override a default machine-wide. The team / implement agent /
# story-point knobs are usually best set per-repo in each target repo's
# autosprint/config.toml; an entry here overrides config.toml machine-wide.
# Every field below has a sensible default.

# =============================================================================
# TARGET REPO
# =============================================================================

# Autosprint operates on the current working directory by default (it must be a
# git repo), or on the path given to `--target` / `autosprint init <path>`.
# TARGET_REPO below is only a debug/dev fallback — it takes effect when cwd is
# not a git repo (e.g. running autosprint from its own repo while developing it).
# Leave it unset for normal use.
#TARGET_REPO=

# =============================================================================
# COMMON KNOBS
# =============================================================================

# Planning team. See `autosprint teams` for the full roster.
#   council       — 6 orthogonal lenses, mixed Opus + GPT-5.5 (default)
#   builder       — 4-member balanced team (2 Opus + 2 GPT-5.5), lighter
#   power         — 10-member team with role specialists (heaviest)
#   solo_opus     — Claude-only (one Opus planner)
#   solo_gpt55    — Copilot-only (one GPT-5.5 planner)
#TEAM=council

# Agent that implements each sprint's task group.
#   implementor_opus48  — Claude Opus 4.8 (strongest, default)
#   implementor_gpt55   — Copilot GPT-5.5 (Copilot-only setups)
#IMPLEMENT_AGENT=implementor_opus48

# Refusal-fallback agent. When the primary returns a refusal-pattern failure,
# the orchestrator reverts and re-dispatches to this agent. Set to empty to
# disable. Default fires roughly when Opus misreads a Read-tool reminder.
#IMPLEMENT_FALLBACK_AGENT=implementor_gpt55

# Agent that runs `autosprint how-far` (read-only distance-to-destination).
#   howfar_opus48  — Claude Opus 4.8 (default)
#   howfar_gpt55   — Copilot GPT-5.5 (Copilot-only setups)
#HOWFAR_AGENT=howfar_opus48

# Sprint cap per run. In reviewed-plan mode (`autosprint run` without
# --auto-replan) this auto-sizes from plan.md length when left unset — 2x the
# pending tasks, floored at 10.
#MAX_SPRINTS=100

# Stop the loop if this many sprints fail in a row.
#MAX_CONSECUTIVE_FAILURES=5

# Console verbosity (0 = noisy debug, 50 = production-quiet, 100 = silent).
#LOG_LEVEL=50

# =============================================================================
# OPTIONAL
# =============================================================================

# How much autosprint speaks aloud via pyttsx3: off | run | reverts | sprints | all.
# Cumulative — 'run' = run-level events only, 'all' adds every per-sprint event.
#SPEAK_LEVEL=run

# Force a fresh Plan phase at least every N sprints.
#REPLAN_EVERY_N_SPRINTS=5

# Auto-replan: regenerate plan.md as the loop runs — the autonomous self-planning
# mode. Default false is reviewed-plan mode (`autosprint run` runs plan.md as-is,
# never inventing new tasks). Usually set per-run with `autosprint run
# --auto-replan` rather than here.
#AUTO_REPLAN=false

# Target-repo test scope at startup ('quick' | 'all' | 'none').
#INITIAL_TESTS=quick

# Test runner for the target repo. 'auto' detects it from marker files
# (pyproject.toml -> pytest, package.json -> vitest); or force 'pytest' / 'vitest'.
# Usually best set per-repo in autosprint/config.toml.
#TARGET_TEST_RUNNER=auto

# Override the Test-phase command verbatim (e.g. a monorepo fan-out script). Empty
# means the runner builds its own command; the parser still follows TARGET_TEST_RUNNER.
#TEST_COMMAND=

# Soft Claude token budget (display-only %-of-budget; 0 = off).
#CLAUDE_TOKEN_LIMIT=0
